      "track_id": "55",
      "begin_time": "00:00:52,466",
      "end_time": "00:00:55,133",
      "content": "他，永不后退！"
    },
    "550015": {
      "id": "550015",
      "track_id": "55",
      "begin_time": "00:00:48,733",
      "end_time": "00:00:51,866",
      "content": "举起辉烬长枪的骑士，总会记得"
    },
    "550014": {
      "id": "550014",
      "track_id": "55",
      "begin_time": "00:00:44,566",
      "end_time": "00:00:48,466",
      "content": "往后此生，无论再面对怎样的对手"
    },
    "550013": {
      "id": "550013",
      "track_id": "55",
      "begin_time": "00:00:40,133",
      "end_time": "00:00:44,000",
      "content": "将那枚光焰锻入了自己最趁手的武器"
    },
    "550012": {
      "id": "550012",
      "track_id": "55",
      "begin_time": "00:00:37,733",
      "end_time": "00:00:40,000",
      "content": "他命王国最好的工匠"
    },
    "550011": {
      "id": "550011",
      "track_id": "55",
      "begin_time": "00:00:34,866",
      "end_time": "00:00:37,466",
      "content": "作为那段璀璨经历的回响"
    },
    "550010": {
      "id": "550010",
      "track_id": "55",
      "begin_time": "00:00:30,800",
      "end_time": "00:00:33,866",
      "content": "而源于永不放弃的意志"
    },
    "550009": {
      "id": "550009",
      "track_id": "55",
      "begin_time": "00:00:28,200",
      "end_time": "00:00:30,733",
      "content": "荣耀并不源自力量"
    },
    "550008": {
      "id": "550008",
      "track_id": "55",
      "begin_time": "00:00:25,733",
      "end_time": "00:00:27,900",
      "content": "青年骑士终于明白"
    },
    "550007": {
      "id": "550007",
      "track_id": "55",
      "begin_time": "00:00:22,766",
      "end_time": "00:00:25,400",
      "content": "紧握手中渐渐温热的光焰"
    },
    "550006": {
      "id": "550006",
      "track_id": "55",
      "begin_time": "00:00:18,066",
      "end_time": "00:00:21,333",
      "content": "他也因之目睹了那场神迹"
    },
    "550005": {
      "id": "550005",
      "track_id": "55",
      "begin_time": "00:00:13,833",
      "end_time": "00:00:17,666",
      "content": "太阳般的精灵终于落下赞许的光焰"
    },
    "550004": {
      "id": "550004",
      "track_id": "55",
      "begin_time": "00:00:11,266",
      "end_time": "00:00:13,633",
      "content": "当友人的意志几乎耗尽"
    },
    "550003": {
      "id": "550003",
      "track_id": "55",
      "begin_time": "00:00:06,633",
      "end_time": "00:00:10,133",
      "content": "同样在阿瓦隆世界经历着考验"
    },
    "550002": {
      "id": "550002",
      "track_id": "55",
      "begin_time": "00:00:03,800",
      "end_time": "00:00:06,633",
      "content": "那位伴其左右的青年骑士"
    },
    "550001": {
      "id": "550001",
      "track_id": "55",
      "begin_time": "00:00:00,833",
      "end_time": "00:00:03,600",
      "content": "在真正的国王诞生之时"
    },
    "540015": {
      "id": "540015",
      "track_id": "54",
      "begin_time": "00:00:45,300",
      "end_time": "00:00:50,266",
      "content": "也与他们不屈的故事，沉眠于海湾之下……"
    },
    "540014": {
      "id": "540014",
      "track_id": "54",
      "begin_time": "00:00:42,466",
      "end_time": "00:00:45,100",
      "content": "而那把烹煮斗志的神器"
    },
    "540013": {
      "id": "540013",
      "track_id": "54",
      "begin_time": "00:00:39,066",
      "end_time": "00:00:42,100",
      "content": "雷雨过后，毒雾不存"
    },
    "540012": {
      "id": "540012",
      "track_id": "54",
      "begin_time": "00:00:35,800",
      "end_time": "00:00:38,466",
      "content": "他们燃起了与之决战的勇气"
    },
    "540011": {
      "id": "540011",
      "track_id": "54",
      "begin_time": "00:00:33,833",
      "end_time": "00:00:35,666",
      "content": "当毒雾追至身前"
    },
    "540010": {
      "id": "540010",
      "track_id": "54",
      "begin_time": "00:00:30,700",
      "end_time": "00:00:33,300",
      "content": "也许逃避永远无法解决问题"
    },
    "540009": {
      "id": "540009",
      "track_id": "54",
      "begin_time": "00:00:28,666",
      "end_time": "00:00:30,600",
      "content": "也许是食物作用"
    },
    "540008": {
      "id": "540008",
      "track_id": "54",
      "begin_time": "00:00:24,033",
      "end_time": "00:00:27,900",
      "content": "船长做出了，令船员们获得不可思议力量的食物！"
    },
    "540007": {
      "id": "540007",
      "track_id": "54",
      "begin_time": "00:00:20,466",
      "end_time": "00:00:23,666",
      "content": "用那根巨牙所做的勺子——海骨牙"
    },
    "540006": {
      "id": "540006",
      "track_id": "54",
      "begin_time": "00:00:17,600",
      "end_time": "00:00:20,233",
      "content": "「呦吼吼，今天想吃什么~」"
    },
    "540005": {
      "id": "540005",
      "track_id": "54",
      "begin_time": "00:00:15,100",
      "end_time": "00:00:17,400",
      "content": "和闪闪发光的巨牙"
    },
    "540004": {
      "id": "540004",
      "track_id": "54",
      "begin_time": "00:00:11,633",
      "end_time": "00:00:15,100",
      "content": "但好在，他们发现了那片可瓦斯海"
    },
    "540003": {
      "id": "540003",
      "track_id": "54",
      "begin_time": "00:00:08,466",
      "end_time": "00:00:11,400",
      "content": "为了自由，大家宁可饿着肚子"
    },
    "540002": {
      "id": "540002",
      "track_id": "54",
      "begin_time": "00:00:04,933",
      "end_time": "00:00:08,033",
      "content": "月兔舰队，依旧扬帆启航"
    },
    "540001": {
      "id": "540001",
      "track_id": "54",
      "begin_time": "00:00:01,100",
      "end_time": "00:00:04,833",
      "content": "即便在被毒雾追袭，最为艰难的日子"
    },
    "530013": {
      "id": "530013",
      "track_id": "53",
      "begin_time": "00:00:41,950",
      "end_time": "00:00:45,383",
      "content": "见证这把神器真正的力量"
    },
    "530012": {
      "id": "530012",
      "track_id": "53",
      "begin_time": "00:00:39,016",
      "end_time": "00:00:41,583",
      "content": "将在未来的漫长时光里"
    },
    "530011": {
      "id": "530011",
      "track_id": "53",
      "begin_time": "00:00:36,250",
      "end_time": "00:00:38,683",
      "content": "而他和他的钢铁朋友们"
    },
    "530010": {
      "id": "530010",
      "track_id": "53",
      "begin_time": "00:00:30,616",
      "end_time": "00:00:34,983",
      "content": "只有熟悉的钢铁与机油味，能给他安慰"
    },
    "530009": {
      "id": "530009",
      "track_id": "53",
      "begin_time": "00:00:27,950",
      "end_time": "00:00:30,250",
      "content": "这里再无父亲的踪迹"
    },
    "530008": {
      "id": "530008",
      "track_id": "53",
      "begin_time": "00:00:25,750",
      "end_time": "00:00:27,650",
      "content": "当少年抵达终点"
    },
    "530007": {
      "id": "530007",
      "track_id": "53",
      "begin_time": "00:00:20,750",
      "end_time": "00:00:24,616",
      "content": "在来不及告别的别离中，驶向远方"
    },
    "530006": {
      "id": "530006",
      "track_id": "53",
      "begin_time": "00:00:18,050",
      "end_time": "00:00:20,416",
      "content": "少年被赋予了守护的使命"
    },
    "530005": {
      "id": "530005",
      "track_id": "53",
      "begin_time": "00:00:15,283",
      "end_time": "00:00:17,450",
      "content": "「用生命去保护它」！"
    },
    "530004": {
      "id": "530004",
      "track_id": "53",
      "begin_time": "00:00:11,150",
      "end_time": "00:00:14,050",
      "content": "也因此，遭来恶毒的窥视"
    },
    "530003": {
      "id": "530003",
      "track_id": "53",
      "begin_time": "00:00:08,216",
      "end_time": "00:00:11,150",
      "content": "它拥有号令机械的无上权能"
    },
    "530002": {
      "id": "530002",
      "track_id": "53",
      "begin_time": "00:00:04,883",
      "end_time": "00:00:07,583",
      "content": "父亲终于道出了它的名字"
    },
    "530001": {
      "id": "530001",
      "track_id": "53",
      "begin_time": "00:00:00,783",
      "end_time": "00:00:04,883",
      "content": "「阿卡纳之心」，在危机降临之际"
    }
  }
}
